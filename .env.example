# Postgres database. Free option: Neon (Vercel -> Storage -> Create -> Neon),
# then copy its connection strings here. Use the same DB locally, or a Neon dev branch.
DATABASE_URL=""
# Direct (unpooled) connection, used by `prisma migrate`. Optional; falls back to DATABASE_URL.
DATABASE_URL_UNPOOLED=""

# Better Auth: generate a secret with `openssl rand -base64 32`
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"   # on Vercel: https://<your-app>.vercel.app

# Google OAuth: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ---------------- AI provider ----------------
# The app picks one automatically:
#   LLM_BASE_URL set       -> open-source model (any OpenAI-compatible server)
#   ANTHROPIC_API_KEY set  -> Claude
#   neither                -> free demo mode (rule-based, no AI)
# Or force one with AI_PROVIDER=open-model | claude | demo

# Option A: Groq free tier, open-weight models (https://console.groq.com/keys)
# LLM_BASE_URL="https://api.groq.com/openai/v1"
# LLM_MODEL="openai/gpt-oss-120b"
# LLM_API_KEY="gsk_..."

# Option B: Ollama on your machine or in Docker (no key needed)
# LLM_BASE_URL="http://localhost:11434/v1"
# LLM_MODEL="qwen2.5:3b"
LLM_BASE_URL=""
LLM_MODEL=""
LLM_API_KEY=""

# Option C: Claude API (paid): https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=""

# Optional: force one background track (a file in public/music) for every new video.
# Leave empty to let the AI choose (see src/remotion/music.ts).
VIDEO_MUSIC=""

# Optional: how much of an attached .md brief is sent to the AI (estimated tokens).
# Long briefs are condensed to their key lines to fit. Defaults: 3000 for Groq's
# free tier, 60000 for Claude. Raise it on a paid Groq plan or a big local model.
BRIEF_MAX_TOKENS=""

# Daily generation limit per user (new videos + revisions). 0 = unlimited.
DAILY_GENERATION_LIMIT="10"
# Comma-separated emails with no limit (e.g. the owner / your team).
DAILY_LIMIT_EXEMPT_EMAILS=""
# When the day resets (IANA timezone). Default: Myanmar time.
DAILY_LIMIT_TIMEZONE="Asia/Yangon"
